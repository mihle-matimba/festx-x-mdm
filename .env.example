# Set these in Vercel → Project Settings → Environment Variables.
# Never expose the service role key to the browser — it's only used
# server-side inside /api functions.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service role key (Project Settings → API → service_role).
# Required so the registration and admin endpoints can bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Admin login for /admin (shared password). Add both in Vercel and mark them
# Sensitive. Never commit real values — this repo is public.
#   ADMIN_PASSWORD        at least 12 characters; use a long random one
#   ADMIN_SESSION_SECRET  at least 32 random characters, e.g. the output of
#                         node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing either one logs every admin out. If either is missing or too
# short, the admin is locked for everyone rather than left open.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Max RSVPs for the Johannesburg tour stop. Leave empty for no limit.
# A whole number caps it (the RSVP button switches to "Fully booked");
# 0 closes RSVPs outright. Redeploy on Vercel after changing it.
RSVP_CAPACITY_JOHANNESBURG=

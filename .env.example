# Set these in Vercel → Project Settings → Environment Variables.
# Never expose the service role key to the browser — it's only used
# server-side inside /api functions.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service role key (Project Settings → API → service_role).
# Required so the registration and admin endpoints can bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects the admin dashboard's API (list/delete registrants).
# Set any long random string; the admin dashboard will prompt for it once
# and remember it in the browser's localStorage.
ADMIN_TOKEN=
